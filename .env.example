# ---- Launch market (Madison, WI) -------------------------------------------
LAUNCH_CITY="Madison, WI"
LAUNCH_CITY_SLUG=madison
LAUNCH_CENTER_LAT=43.0731
LAUNCH_CENTER_LNG=-89.4012
LAUNCH_RADIUS_KM=16
LAUNCH_BBOX=-89.62,42.95,-89.18,43.22
LAUNCH_TZ=America/Chicago

# ---- Supabase --------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres URL (worker + scripts). Use the pooler "session" URL from Supabase dashboard.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ---- Claude (deal extraction) ---------------------------------------------
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-opus-5
EXTRACTION_EFFORT=low
EXTRACTION_AUTO_APPROVE_THRESHOLD=0.75

# ---- Scraping sources -------------------------------------------------------
APIFY_TOKEN=
FIRECRAWL_API_KEY=
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
FLIPP_ENABLED=false

# ---- Geocoding --------------------------------------------------------------
NEXT_PUBLIC_MAPBOX_TOKEN=
MAPBOX_SERVER_TOKEN=

# ---- App --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_EMAILS=barnes.lucas@icloud.com
WORKER_POLL_MS=5000
WORKER_BATCH=5

# ---- Later (Phase 5) --------------------------------------------------------
STRIPE_SECRET_KEY=

# Google Maps Platform key with "Places API (New)" enabled — ratings, hours, photos, reviews for every place (pnpm google:sync)
GOOGLE_PLACES_API_KEY=
